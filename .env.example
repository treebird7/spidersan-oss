# Spidersan Environment Configuration
# Copy this to .env and fill in your values

# Current environment: production, staging, or local
SPIDERSAN_ENV=production

# ── Cross-machine registry sync ─────────────────────────────────────────────
# Optional. Without it, Spidersan uses only the local JSON registry (.spidersan/).
# Sync goes through a module you provide, named in YOUR ~/.spidersanrc
# ({"storage":{"syncModule":"~/path/to/client.mjs"}}) or here as an absolute path.
# It must export createRegistrySyncClient(). There is no built-in hosted client:
# SUPABASE_URL / SUPABASE_KEY no longer enable sync.
# SPIDERSAN_SYNC_MODULE=/abs/path/to/registry-client.mjs

# ── Activity log upload (optional) ──────────────────────────────────────────
# Only the optional activity-log upload still reads these. Never commit real keys.
# SPIDERSAN_SUPABASE_URL=
# SPIDERSAN_SUPABASE_KEY=

# Agent Identity (used in spidermail from/to fields)
# Examples: spidersan-agent, claude-code, cursor, windsurf
SPIDERSAN_AGENT=spidersan-agent

# Conflict alert delivery (sp-8iqm). Room join token minted by a human on
# toak.me; it is a room-wide read+write secret, so leave this blank and inject
# it from the envoak vault (secret: toak/SPIDERSAN_ROOM_TOKEN) rather than
# writing it to disk:
#   envoak vault inject --key <agent-key> -- spidersan conflicts --notify
# Unset = alerts are logged as NOT NOTIFIED, never silently dropped.
SPIDERSAN_ROOM_TOKEN=
